{
  "name": "uni-ui-snippets-vscode",
  "displayName": "uni-ui-snippets",
  "version": "0.7.1",
  "description": "uni-ui 基本能力代码片段。",
  "categories": [
    "Snippets"
  ],
  "keywords": [
    "uniapp",
    "uni-app",
    "uni-ui",
    "uniui",
    "snippet",
    "snippets"
  ],
  "homepage": "https://github.com/uni-helper/uni-ui-snippets-vscode#readme",
  "bugs": {
    "url": "https://github.com/uni-helper/uni-ui-snippets-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/uni-helper/uni-ui-snippets-vscode"
  },
  "license": "MIT",
  "author": {
    "name": "ModyQyW",
    "email": "wurui-dev@foxmail.com",
    "url": "https://modyqyw.github.io"
  },
  "publisher": "uni-helper",
  "type": "module",
  "files": [
    "snippets",
    "LICENSE",
    "uni-helper.png"
  ],
  "scripts": {
    "fix": "ultracite fix",
    "prepare": "is-ci || lefthook install",
    "publish": "conc \"npm:publish:vscode\" \"npm:publish:openvsx\"",
    "publish:openvsx": "ovsx publish",
    "publish:vscode": "vsce package && vsce publish",
    "release": "bumpp --all -x=\"tsx ./scripts/update-readme.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "contributes": {
    "snippets": [
      {
        "language": "vue-html",
        "path": "./snippets/vue-html.json"
      },
      {
        "language": "vue",
        "path": "./snippets/vue-html.json"
      },
      {
        "language": "html",
        "path": "./snippets/vue-html.json"
      }
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@tsconfig/node26": "^26.0.1",
    "@types/node": "^26.5.1",
    "@vscode/vsce": "^3.9.2",
    "bumpp": "^12.3.0",
    "concurrently": "^10.0.5",
    "ovsx": "^1.2.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "ultracite": "^7.11.1"
  },
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=18",
    "vscode": "^1.40.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "warn"
    }
  },
  "icon": "uni-helper.png",
  "allowScripts": {
    "@vscode/vsce-sign@2.0.9": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "keytar@7.9.0": true
  },
  "sponsor": {
    "url": "https://github.com/ModyQyW/sponsors"
  }
}
